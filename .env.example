# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-application-specific-token

# Signing Secret (Basic Information -> App Credentials)
SLACK_SIGNING_SECRET=application-specific-signing-secret

# App-Level Token (Basic Information -> App-Level Tokens, or Socket Mode)
SLACK_APP_TOKEN=xapp-application-specific-app-token

# Port for HTTP health checks (optional)
PORT=3000